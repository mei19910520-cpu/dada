# ============================================================
# AI R&D Department — 環境變數設定
# 複製此檔案為 .env 並填入真實值
# cp .env.example .env
# ============================================================

# ── 基礎設定 ──────────────────────────────────────────────
TIMEZONE=Asia/Taipei
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
# 生產環境改為你的域名:
# N8N_HOST=your-domain.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://your-domain.com

# ── 安全金鑰 (必填，32位以上隨機字串) ─────────────────────
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-here-change-me

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your-strong-postgres-password-here

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=your-strong-redis-password-here

# ── Qdrant 向量資料庫 ─────────────────────────────────────
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_URL=http://qdrant:6333

# ── AI 模型 API Keys ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── Notion 整合 ───────────────────────────────────────────
NOTION_API_KEY=secret_your-notion-api-key-here
NOTION_KNOWLEDGE_DB_ID=your-notion-knowledge-database-id
NOTION_TASKS_DB_ID=your-notion-tasks-database-id
NOTION_INSIGHTS_DB_ID=your-notion-insights-database-id
NOTION_FORMS_DB_ID=your-notion-forms-database-id

# ── Google 整合 ───────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json
GOOGLE_SPREADSHEET_ID=your-main-google-sheet-id
GOOGLE_FORM_ID=your-google-form-id

# ── 通知渠道 ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_USER_ID=your-line-user-id

# ── 業務設定 ──────────────────────────────────────────────
COMPANY_NAME=你的公司名稱
BUSINESS_TYPE=貓舍/電商/服務業
TARGET_MARKET=台灣/寵物市場
INDUSTRY_KEYWORDS=貓咪,貓舍,寵物,布偶貓,英短

# ── Open WebUI ────────────────────────────────────────────
OPEN_WEBUI_SECRET=your-open-webui-secret-key

# ── Ollama 本地模型 ───────────────────────────────────────
OLLAMA_DEFAULT_MODEL=llama3.2:3b
# 推薦模型: llama3.2:3b (快速), llama3.1:8b (平衡), llama3.1:70b (高品質)

# ── Threads 關鍵字陷阱系統 ────────────────────────────────
APIFY_TOKEN=apify_api_your-token-here
GOOGLE_SHEET_ID=your-threads-trap-sheet-id
# 高分潛客 LINE 告警使用 LINE Messaging API（LINE Notify 已於 2025-03-31 停止）
# 變數已在上方「通知渠道」區塊：LINE_CHANNEL_ACCESS_TOKEN + LINE_USER_ID
