    {
      "parameters": { "jsCode": "// Stage 4 guardrail scan — see references/guardrails.md\nconst banned=($env.BANNED_TERMS||'cure,guaranteed returns,miracle,100%').split(',');\nreturn items.map(i=>{const t=(i.json.caption||'')+' '+(i.json.hook||'');const hit=banned.find(b=>t.toLowerCase().includes(b.trim().toLowerCase()));i.json.guardrail={hard_block:!!hit||(i.json.brand_fit||1)<0.6,reason:hit?('banned:'+hit):''};i.json.status=i.json.guardrail.hard_block?'flagged':i.json.status;return i;});" },
