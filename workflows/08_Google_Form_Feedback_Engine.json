          { "node": "RAG向量化客戶數據", "type": "main", "index": 0 },
          { "node": "AI潛客評分Agent", "type": "main", "index": 0 }
        ]
      ]
    },
    "AI潛客評分Agent": {
      "main": [[{ "node": "解析評分結果", "type": "main", "index": 0 }]]
    },
    "解析評分結果": {
      "main": [[{ "node": "是熱門潛客?", "type": "main", "index": 0 }]]
    },
    "是熱門潛客?": {
      "main": [
        [{ "node": "立即通知(熱潛客)", "type": "main", "index": 0 }],
        [{ "node": "回應處理完成", "type": "main", "index": 0 }]
      ]
    },
    "立即通知(熱潛客)": {
      "main": [[{ "node": "回應處理完成", "type": "main", "index": 0 }]]
    },
    "LLM (評分)": {}
  },
